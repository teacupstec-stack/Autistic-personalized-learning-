# ==============================================================================
# C2 Component Git Ignore Specification
# ==============================================================================

# --- Operating System Files (macOS / Linux / Windows) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Python Environment & Bytecode ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
.env

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# --- Node.js & TypeScript ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# Build artifacts (dist folder)
dist/*
!dist/validate.js

# --- Project-Specific Research Safeguards (per DECISIONS.md) ---
# Raw simulated datasets and generated logs (only split_manifest.csv is tracked)
data/raw/
data/versions/
*.log

# Large binary model checkpoints (scripts, metadata, and JSON weights are tracked)
models/*.pt
models/*.bin
models/*.onnx
*.onnx
*.pt

# Temporary browser / test caches
.chrome_tmp/
.temp/
tmp/
