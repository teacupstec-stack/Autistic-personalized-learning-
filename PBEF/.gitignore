# ==============================================================================
# Git Ignore Configuration - Component 3: Participation Forecasting (PBEF)
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python byte-code and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints*/

# Confidential & Raw Participant Data
# (CRITICAL ETHICAL GOVERNANCE: Never commit real, identifiable participant data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Synthetic data is permitted for verification, but ignore large generated bundles
data/synthetic/*.npz
data/synthetic/windows.npz
data/synthetic/demo_events_*
data/engagnition/*.npz
data/engagnition/raw/

# Heavy Model Checkpoints & Weights
models/**/*.pt
models/**/*.onnx
models/**/*.pkl
models/**/*.bin
models/**/*.npy
!models/.gitkeep

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Temporary Runs
*.log
scratch/
tmp/
temp/

# Node / Web App Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
app/dist/
app/build/
app/.next/
