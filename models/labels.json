{
  "actions": {
    "easy_visual": 0,
    "easy_text": 1,
    "medium_visual": 2,
    "medium_text": 3
  },
  "input_features": [
    "skill_estimate",
    "recent_success_rate",
    "recent_independent_rate",
    "hint_frequency",
    "c3_risk_value",
    "c3_confidence",
    "c3_is_known",
    "c3_is_missing",
    "consecutive_failures"
  ],
  "reward_formula": "clip(0.7*success + 0.3*independent - 0.05*min(hints,4) - 0.30*distress, -1.0, 1.0)"
}